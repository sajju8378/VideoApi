# Application & Environment
APP_ENV=development
APP_URL="MY_APP_URL"
PORT=3000

# Authentication & Security
JWT_SECRET=super-secret-production-jwt-key-min-32-chars

# Database & Queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivideo
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PATH=./storage
STORAGE_DRIVER=local # local | s3
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI Model & Inference Pipeline
MODEL_ID=stabilityai/stable-video-diffusion-img2vid-xt # or THUDM/CogVideoX-5b, Lightricks/LTX-Video
MODEL_PATH=./models
CUDA_DEVICE=0
INFERENCE_WORKER_URL=http://localhost:5000/internal/generate
INFERENCE_INTERNAL_TOKEN=internal-worker-secret-token

# Video & Generation Limits
MAX_UPLOAD_MB=25
MAX_VIDEO_DURATION=8
DEFAULT_FPS=24
DEFAULT_RESOLUTION=720p
TEST_MODE=true # Enables lightweight CPU test pipeline when no CUDA GPU is detected

